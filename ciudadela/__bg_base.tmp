<!-- FONDO NATURALEZA -->
<div id="nature-bg">
  <canvas id="fireflies"></canvas>
  <!-- SVG Paisaje de selva/bosque -->
  <svg id="landscape-svg" viewBox="0 0 1440 500" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
    <!-- Luna -->
    <circle cx="1150" cy="80" r="55" fill="#f5e8b0" opacity="0.18"/>
    <circle cx="1150" cy="80" r="48" fill="#fdf5d0" opacity="0.22"/>
    <!-- Niebla de fondo -->
    <ellipse cx="720" cy="500" rx="900" ry="120" fill="#0d2208" opacity="0.8"/>
    <!-- Monta├▒as lejanas -->
    <polygon points="0,500 0,300 200,180 400,280 600,160 800,260 1000,140 1200,240 1440,160 1440,500" fill="#0f2010" opacity="0.9"/>
    <!-- Segunda capa monta├▒as -->
    <polygon points="0,500 0,360 100,290 300,340 500,240 700,300 900,200 1100,280 1300,220 1440,260 1440,500" fill="#132a10" opacity="0.85"/>
    <!-- Selva fondo -->
    <polygon points="0,500 0,400 60,350 120,390 180,340 240,380 300,330 360,370 420,320 480,365 540,310 600,360 660,300 720,350 780,290 840,345 900,285 960,340 1020,280 1080,335 1140,270 1200,325 1260,260 1320,315 1380,255 1440,300 1440,500" fill="#163512" opacity="0.9"/>
    <!-- ├ürboles grandes izquierda -->
    <rect x="20" y="200" width="18" height="300" fill="#0a2008" rx="4"/>
    <ellipse cx="29" cy="195" rx="45" ry="80" fill="#122e0e" opacity="0.95"/>
    <ellipse cx="29" cy="155" rx="35" ry="65" fill="#163812" opacity="0.9"/>
    <ellipse cx="29" cy="120" rx="25" ry="50" fill="#1a4014" opacity="0.85"/>
    <!-- ├ürbol 2 -->
    <rect x="90" y="250" width="15" height="250" fill="#0a2008" rx="3"/>
    <ellipse cx="97" cy="245" rx="38" ry="70" fill="#102a0c" opacity="0.95"/>
    <ellipse cx="97" cy="200" rx="28" ry="55" fill="#143010" opacity="0.9"/>
    <!-- ├ürbol 3 -->
    <rect x="160" y="230" width="20" height="270" fill="#0a2008" rx="4"/>
    <ellipse cx="170" cy="225" rx="50" ry="90" fill="#122e0e" opacity="0.95"/>
    <ellipse cx="170" cy="180" rx="38" ry="70" fill="#163812" opacity="0.9"/>
    <ellipse cx="170" cy="135" rx="28" ry="55" fill="#1a4014" opacity="0.85"/>
    <!-- ├ürboles derecha -->
    <rect x="1350" y="210" width="18" height="290" fill="#0a2008" rx="4"/>
    <ellipse cx="1359" cy="205" rx="45" ry="80" fill="#122e0e" opacity="0.95"/>
    <ellipse cx="1359" cy="160" rx="35" ry="65" fill="#163812" opacity="0.9"/>
    <ellipse cx="1359" cy="120" rx="25" ry="50" fill="#1a4014" opacity="0.85"/>
    <rect x="1280" y="250" width="16" height="250" fill="#0a2008" rx="3"/>
    <ellipse cx="1288" cy="245" rx="42" ry="75" fill="#102a0c" opacity="0.95"/>
    <ellipse cx="1288" cy="200" rx="32" ry="58" fill="#143010" opacity="0.9"/>
    <!-- ├ürboles centro -->
    <rect x="640" y="280" width="22" height="220" fill="#0a2008" rx="5"/>
    <ellipse cx="651" cy="275" rx="55" ry="95" fill="#122e0e" opacity="0.9"/>
    <ellipse cx="651" cy="225" rx="42" ry="75" fill="#163812" opacity="0.85"/>
    <ellipse cx="651" cy="175" rx="30" ry="58" fill="#1a4014" opacity="0.8"/>
    <!-- Hierbas / arbustos primer plano -->
    <ellipse cx="100" cy="500" rx="120" ry="40" fill="#1a4010" opacity="0.95"/>
    <ellipse cx="350" cy="500" rx="100" ry="35" fill="#163a0e" opacity="0.9"/>
    <ellipse cx="700" cy="500" rx="150" ry="45" fill="#1a4010" opacity="0.95"/>
    <ellipse cx="1100" cy="500" rx="130" ry="40" fill="#163a0e" opacity="0.9"/>
    <ellipse cx="1380" cy="500" rx="110" ry="38" fill="#1a4010" opacity="0.95"/>
    <!-- R├¡o / reflejo -->
    <ellipse cx="720" cy="470" rx="200" ry="15" fill="rgba(100,180,60,0.04)" opacity="0.6"/>
  </svg>
</div>

<!-- Overlay semitransparente -->
<div id="overlay"></div>

