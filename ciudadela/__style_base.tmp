<style>
:root{
  --gold:#e8c86a;--gd:#b89a40;--gl:#f5e0a0;
  --text:#f0e8d0;--dim:rgba(240,232,208,0.6);
  --card:rgba(10,15,8,0.82);--card-b:rgba(232,200,106,0.18);
  --green-dark:#0d1a0a;--green-mid:#1a2e14;
  --shadow:rgba(0,0,0,0.6);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}

/* ===== FONDO NATURALEZA ===== */
body{
  font-family:'Cormorant Garamond',serif;
  color:var(--text);
  min-height:100vh;
  background:#0a1208;
  overflow-x:hidden;
  position:relative;
}

/* Paisaje SVG como fondo fijo */
#nature-bg{
  position:fixed;inset:0;z-index:0;
  background:
    linear-gradient(180deg,
      #040c02 0%,
      #0a1a06 15%,
      #122806 30%,
      #0f2008 50%,
      #081506 70%,
      #050d04 100%
    );
  overflow:hidden;
}
/* Cielo con lunas y estrellas */
#nature-bg::before{
  content:'';
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 60% 40% at 50% -10%, rgba(100,180,60,0.12) 0%, transparent 70%),
    radial-gradient(circle at 80% 15%, rgba(232,200,106,0.25) 0%, rgba(232,200,106,0.08) 15%, transparent 30%),
    radial-gradient(circle at 20% 10%, rgba(200,220,150,0.08) 0%, transparent 25%);
}
/* Niebla de selva */
#nature-bg::after{
  content:'';
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 120% 30% at 50% 100%, rgba(15,40,10,0.9) 0%, transparent 60%),
    radial-gradient(ellipse 80% 20% at 30% 85%, rgba(20,60,12,0.6) 0%, transparent 50%),
    radial-gradient(ellipse 80% 20% at 70% 90%, rgba(20,60,12,0.5) 0%, transparent 50%);
}

/* SVG Paisaje */
#landscape-svg{
  position:absolute;
  bottom:0;left:0;right:0;
  height:55%;
  opacity:0.7;
}

/* Canvas de part├¡culas (luci├®rnagas) */
#fireflies{position:absolute;inset:0;pointer-events:none}

/* ===== OVERLAY ===== */
#overlay{
  position:fixed;inset:0;z-index:1;
  background:linear-gradient(180deg,
    rgba(4,10,2,0.55) 0%,
    rgba(4,10,2,0.2) 40%,
    rgba(4,10,2,0.65) 100%
  );
  pointer-events:none;
}

/* ===== NAV ===== */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  height:62px;display:flex;align-items:center;padding:0 24px;gap:16px;
  background:rgba(6,14,4,0.88);
  border-bottom:1px solid rgba(100,180,60,0.2);
  backdrop-filter:blur(20px);
}
.brand{
  font-family:'Cinzel',serif;font-size:1rem;font-weight:900;
  letter-spacing:.22em;color:var(--gold);text-decoration:none;
}
.nav-links{display:flex;gap:4px;flex:1}
.nl{
  font-family:'Cinzel',serif;font-size:.58rem;letter-spacing:.1em;
  color:var(--dim);text-decoration:none;padding:7px 12px;
  border-radius:6px;transition:all .2s;text-transform:uppercase;
}
.nl:hover,.nl.on{color:var(--gold);background:rgba(100,180,60,0.1)}
.nav-r{display:flex;align-items:center;gap:10px;margin-left:auto}
.cart-btn{
  display:flex;align-items:center;gap:8px;padding:8px 18px;
  border:1px solid rgba(232,200,106,0.35);border-radius:8px;
  font-family:'Cinzel',serif;font-size:.62rem;letter-spacing:.1em;
  color:var(--gold);background:rgba(232,200,106,0.06);
  cursor:pointer;transition:all .25s;position:relative;
}
.cart-btn:hover{background:rgba(232,200,106,0.14);box-shadow:0 0 20px rgba(100,200,60,0.15)}
.cart-count{
  position:absolute;top:-7px;right:-7px;width:20px;height:20px;
  border-radius:50%;background:var(--gold);color:#0a1208;
  font-size:.62rem;font-weight:900;display:flex;align-items:center;justify-content:center;
}
@media(max-width:750px){.nav-links{display:none}}

/* ===== HERO ===== */
.hero{
  position:relative;z-index:10;
  text-align:center;padding:120px 24px 60px;
}
.hero-tag{
  font-family:'Cinzel',serif;font-size:.6rem;letter-spacing:.4em;
  color:rgba(100,200,60,0.8);text-transform:uppercase;margin-bottom:12px;
}
.hero-title{
  font-family:'Cinzel',serif;
  font-size:clamp(2rem,5vw,3.5rem);
  font-weight:900;color:var(--text);
  letter-spacing:.05em;line-height:1.1;
  text-shadow:0 4px 30px rgba(0,0,0,0.8),0 0 60px rgba(100,200,60,0.15);
}
.hero-title span{color:var(--gold)}
.hero-sub{
  font-family:'Cormorant Garamond',serif;
  font-size:1.05rem;color:var(--dim);
  margin-top:10px;font-style:italic;
}

/* ===== BARRA B├ÜSQUEDA ===== */
.search-wrap{
  position:relative;z-index:10;
  max-width:580px;margin:0 auto 32px;padding:0 24px;
}
.search-bar{
  width:100%;padding:14px 52px 14px 20px;
  background:rgba(10,20,8,0.85);
  border:1px solid rgba(100,180,60,0.3);
  border-radius:50px;
  font-family:'Cormorant Garamond',serif;font-size:1rem;
  color:var(--text);outline:none;backdrop-filter:blur(12px);
  transition:border-color .3s,box-shadow .3s;
}
.search-bar:focus{
  border-color:rgba(100,200,60,0.6);
  box-shadow:0 0 25px rgba(100,200,60,0.15);
}
.search-bar::placeholder{color:var(--dim)}
.search-icon{
  position:absolute;right:38px;top:50%;transform:translateY(-50%);
  color:rgba(100,200,60,0.6);font-size:1.1rem;pointer-events:none;
}

/* ===== FILTROS ===== */
.filter-wrap{
  position:relative;z-index:10;
  display:flex;flex-wrap:wrap;gap:8px;justify-content:center;
  padding:0 24px 28px;
}
.fb{
  font-family:'Cinzel',serif;font-size:.58rem;letter-spacing:.12em;
  padding:8px 16px;border-radius:50px;border:1px solid rgba(100,180,60,0.25);
  color:var(--dim);background:rgba(10,20,8,0.7);cursor:pointer;
  transition:all .25s;text-transform:uppercase;backdrop-filter:blur(8px);
}
.fb:hover{border-color:rgba(100,200,60,0.5);color:rgba(150,230,80,0.9)}
.fb.on{
  background:rgba(60,120,20,0.4);
  border-color:rgba(100,200,60,0.7);
  color:#b8f078;
  box-shadow:0 0 15px rgba(100,200,60,0.2);
}

/* ===== INFO BAR ===== */
.info-bar{
  position:relative;z-index:10;
  display:flex;justify-content:space-between;align-items:center;
  max-width:1320px;margin:0 auto 16px;padding:0 24px;
  font-family:'Cinzel',serif;font-size:.62rem;letter-spacing:.1em;
  color:var(--dim);
}

/* ===== GRID ===== */
.catalog{position:relative;z-index:10;max-width:1320px;margin:0 auto;padding:0 20px 80px}
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:20px;
}

/* ===== TARJETAS ===== */
.card{
  background:var(--card);
  border:1px solid var(--card-b);
  border-radius:14px;
  overflow:hidden;
  transition:transform .3s,box-shadow .3s,border-color .3s;
  cursor:pointer;
  backdrop-filter:blur(16px);
}
.card:hover{
  transform:translateY(-6px);
  box-shadow:0 20px 50px rgba(0,0,0,0.5),0 0 30px rgba(100,200,60,0.12);
  border-color:rgba(100,200,60,0.4);
}
.card-img{
  width:100%;aspect-ratio:1;object-fit:cover;
  transition:transform .4s;display:block;
}
.card:hover .card-img{transform:scale(1.04)}
.card-body{padding:14px}
.card-cat{
  font-family:'Cinzel',serif;font-size:.52rem;letter-spacing:.18em;
  color:rgba(100,200,60,0.75);text-transform:uppercase;margin-bottom:6px;
}
.card-name{
  font-family:'Cinzel',serif;font-size:.78rem;font-weight:600;
  color:var(--text);line-height:1.3;margin-bottom:6px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.card-desc{
  font-size:.78rem;color:var(--dim);line-height:1.4;margin-bottom:12px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.card-footer{display:flex;align-items:center;justify-content:space-between;gap:8px}
.card-price{
  font-family:'Cinzel',serif;font-size:.95rem;font-weight:700;color:var(--gold);
}
.add-btn{
  font-family:'Cinzel',serif;font-size:.55rem;letter-spacing:.1em;
  padding:7px 12px;border-radius:6px;cursor:pointer;
  background:rgba(60,120,20,0.35);
  border:1px solid rgba(100,200,60,0.5);
  color:rgba(150,230,80,0.9);transition:all .2s;
  white-space:nowrap;
}
.add-btn:hover{background:rgba(60,120,20,0.6);box-shadow:0 0 12px rgba(100,200,60,0.25)}

/* ===== PAGINACI├ôN ===== */
.pagination{
  display:flex;justify-content:center;align-items:center;
  gap:6px;padding:40px 24px 20px;position:relative;z-index:10;
}
.pg{
  font-family:'Cinzel',serif;font-size:.65rem;letter-spacing:.08em;
  padding:8px 14px;border-radius:8px;cursor:pointer;
  border:1px solid rgba(100,180,60,0.25);
  color:var(--dim);background:rgba(10,20,8,0.7);
  transition:all .2s;
}
.pg:hover{border-color:rgba(100,200,60,0.5);color:rgba(150,230,80,0.9)}
.pg.on{background:rgba(60,120,20,0.5);border-color:rgba(100,200,60,0.7);color:#b8f078}

/* ===== CARRITO ===== */
.cart-overlay{
  display:none;position:fixed;inset:0;z-index:400;
  background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);
}
.cart-overlay.open{display:block}
.cart-panel{
  position:fixed;top:0;right:-400px;width:380px;height:100vh;z-index:500;
  background:rgba(8,16,6,0.97);border-left:1px solid rgba(100,200,60,0.2);
  backdrop-filter:blur(20px);transition:right .35s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column;padding:24px;
}
.cart-panel.open{right:0}
.cart-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.cart-head h2{font-family:'Cinzel',serif;font-size:.9rem;letter-spacing:.15em;color:var(--gold)}
.close-cart{background:none;border:none;color:var(--dim);font-size:1.4rem;cursor:pointer}
.cart-items{flex:1;overflow-y:auto}
.cart-item{
  display:flex;gap:12px;padding:12px 0;border-bottom:1px solid rgba(100,200,60,0.1);
}
.cart-item img{width:60px;height:60px;object-fit:cover;border-radius:8px}
.ci-info{flex:1}
.ci-name{font-family:'Cinzel',serif;font-size:.7rem;color:var(--text);margin-bottom:4px}
.ci-price{font-size:.8rem;color:var(--gold)}
.remove-item{background:none;border:none;color:rgba(200,80,80,0.7);cursor:pointer;font-size:1rem}
.empty-cart{text-align:center;padding:40px;color:var(--dim);font-style:italic}
.cart-foot{padding-top:16px;border-top:1px solid rgba(100,200,60,0.15)}
.cart-total{display:flex;justify-content:space-between;font-family:'Cinzel',serif;font-size:.85rem;color:var(--text);margin-bottom:16px}
.checkout-btn{
  width:100%;padding:14px;border-radius:10px;cursor:pointer;
  font-family:'Cinzel',serif;font-size:.75rem;letter-spacing:.12em;
  background:linear-gradient(135deg,rgba(60,120,20,0.7),rgba(100,180,40,0.5));
  border:1px solid rgba(100,200,60,0.5);color:#b8f078;
  transition:all .25s;
}
.checkout-btn:hover{background:linear-gradient(135deg,rgba(80,150,30,0.8),rgba(120,200,50,0.6));box-shadow:0 0 20px rgba(100,200,60,0.3)}

/* ===== TOAST ===== */
.toast{
  position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);
  background:rgba(10,20,6,0.97);border:1px solid rgba(100,200,60,0.4);
  border-radius:10px;padding:12px 24px;font-family:'Cinzel',serif;font-size:.7rem;
  letter-spacing:.08em;color:var(--text);z-index:9999;
  opacity:0;transition:all .3s;pointer-events:none;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media(max-width:600px){
  .grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px}
  .cart-panel{width:100%;right:-100%;border-left:none}
}

/* ===== LUCI├ëRNAGAS CSS (backup) ===== */
@keyframes float{0%,100%{transform:translateY(0) translateX(0);opacity:.3}50%{transform:translateY(-30px) translateX(15px);opacity:.9}}
</style>
